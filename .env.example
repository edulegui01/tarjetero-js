PORT=8091
WEBHOOK_PATH=/webhook/nfc

HIKVISION_IP=192.0.0.64
HIKVISION_PORT=80
HIKVISION_USER=admin
HIKVISION_PASSWORD=

# IP de este servidor tal como la tiene que ver la placa (se usa para
# autoregistrar el webhook en la placa al arrancar, ver README). Si se deja
# vacío se autodetecta preguntándole al sistema operativo por qué IP local
# saldría un paquete hacia HIKVISION_IP (funciona bien incluso con VPNs o
# adaptadores virtuales de por medio). Fijarla a mano acá solo si esa
# autodetección da una IP incorrecta.
SERVER_IP=

# API TSM Contas: se consulta en cada lectura de tarjeta si la cuenta tiene
# una identificación de deuda abierta (pago pendiente) antes de abrir puerta.
# El cliente hace login contra GetToken y cachea el token hasta que vence
# (campo "validate" de la respuesta), pidiendo uno nuevo cuando haga falta.
TSM_API_HOST=
TSM_API_PORT=80
TSM_USUARIO=
TSM_SENHA=

# Login de http://<este-server>:<PORT>/admin (HTTP Basic Auth). Sin esto,
# /admin rechaza todas las requests.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Mensajes, IDs de puerta (PUERTA_TARJETA_DENEGADA/HABILITADA/MOLINETE),
# TSM_CODIGO_EMPRESA, TSM_SERIE_CARTAO, DEBOUNCE_SECONDS,
# MAX_EVENT_AGE_SECONDS, etc. ya no se configuran acá: se editan en caliente
# desde /admin y quedan guardados en params.json (se crea solo con valores
# por defecto la primera vez que se guarda algo desde esa página).
